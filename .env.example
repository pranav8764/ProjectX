# App
APP_NAME=PlantBrainAI
APP_ENV=development
APP_URL=http://localhost:3000

# Auth
AUTH_PROVIDER=betterauth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://plantbrain:plantbrain@localhost:5432/plantbrain
POSTGRES_DB=plantbrain
POSTGRES_USER=plantbrain
POSTGRES_PASSWORD=

# Vector search
VECTOR_DB=pgvector

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=plantbrain-documents
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MINIO_ROOT_USER=plantbrain
MINIO_ROOT_PASSWORD=

# AI providers
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Services
WEB_URL=http://localhost:3000

REDIS_URL=redis://localhost:6379

# Messaging
EVENT_BUS=redis-streams
EVENT_STREAM_PREFIX=plantbrain

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
