# App
APP_NAME=PlantBrainAI
APP_ENV=development
APP_URL=http://localhost:3000

# Auth
AUTH_PROVIDER=demo
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Database
DATABASE_URL=postgresql://plantbrain:plantbrain@localhost:5432/plantbrain

# Vector search
VECTOR_DB=pgvector

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=plantbrain-documents
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI providers
LLM_PROVIDER=
LLM_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# Services
WEB_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:8080
IDENTITY_SERVICE_URL=http://localhost:8081
DOCUMENT_SERVICE_URL=http://localhost:8082
RAG_SERVICE_URL=http://localhost:8083
ASSET_SERVICE_URL=http://localhost:8084
GRAPH_SERVICE_URL=http://localhost:8085
RCA_SERVICE_URL=http://localhost:8086
COMPLIANCE_SERVICE_URL=http://localhost:8087
REPORT_SERVICE_URL=http://localhost:8088
AUDIT_SERVICE_URL=http://localhost:8089
NOTIFICATION_SERVICE_URL=http://localhost:8090
AI_ORCHESTRATOR_SERVICE_URL=http://localhost:8091
INGESTION_WORKER_HEALTH_URL=http://localhost:8092
REDIS_URL=redis://localhost:6379

# Messaging
EVENT_BUS=redis-streams
EVENT_STREAM_PREFIX=plantbrain

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
