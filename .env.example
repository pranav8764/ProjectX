# Copy to .env and fill in. Values here are safe local-dev defaults; replace secrets
# before any shared/hosted deployment.

# App
APP_ENV=development
# Seed demo users/sessions (incl. the smoke-test token). Never set true in production.
SEED_DEV_DATA=true

# ---------------------------------------------------------------------------
# Database — single source of truth for api, ai, and web.
#
# Option A (default): Supabase. Use the SESSION pooler string (port 5432), NOT the
#   6543 transaction pooler — asyncpg + LangGraph checkpointer need prepared statements.
#   Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Option B: bundled local Postgres. Run `docker compose --profile local-db up` and use:
#   DATABASE_URL=postgresql://plantbrain:plantbrain@postgres:5432/plantbrain
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://plantbrain:plantbrain@postgres:5432/plantbrain

# Only used by the bundled local Postgres (docker compose --profile local-db)
POSTGRES_DB=plantbrain
POSTGRES_USER=plantbrain
POSTGRES_PASSWORD=plantbrain

# Object storage (MinIO / S3-compatible). Password must be >= 8 chars.
STORAGE_BUCKET=plantbrain-documents
MINIO_ROOT_USER=plantbrain
MINIO_ROOT_PASSWORD=plantbrain-dev-secret
# Browser-reachable endpoint for presigned download URLs (must resolve from the client).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# AI providers (required for real embeddings + answers; without them ingestion is
# marked PARTIAL_SUCCESS and copilot returns a no-evidence response)
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional model overrides (defaults are current, generally-available models)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=text-embedding-004
# GROQ_MODEL=llama-3.3-70b-versatile

# Auth (BetterAuth). Generate a random 32+ char secret, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
